# A sample.
mainmenu "Sample configuration"

config SAMPLE
	bool "Enable the sample"
	default y
	help
	  This option enables the sample.

config SAMPLE_LIMIT
	int "The limit"
	range 1 100
	default 10
	depends on SAMPLE

choice
	prompt "Colour"
	default COLOUR_GREEN

config COLOUR_RED
	bool "Red"

config COLOUR_GREEN
	bool "Green"

endchoice

menu "Advanced"
	depends on SAMPLE

config SAMPLE_NAME
	string "Name"
	default "sample"

endmenu

source "drivers/Kconfig"
